#!/bin/sh
# schema/erf.generated.ts is generated from schema/erf.schema.json and never edited by hand.
# Before every commit: if the generated file is out of date, regenerate it and
# stage it, so the commit carries the schema and its projection together.
# Wired by `git config core.hooksPath .githooks` (npm's postinstall does this).
set -e
cd "$(git rev-parse --show-toplevel)"
if ! python3 tools/generate/generate-types.py --check >/dev/null 2>&1; then
  python3 tools/generate/generate-types.py --write
  git add schema/erf.generated.ts
  echo "pre-commit: schema/erf.generated.ts regenerated from the schema and staged"
fi
# The validator's version tracks the specification's (major.minor); refuse a commit that breaks that.
python3 tools/lint/lint-validator-version.py || exit 1
