node_modules/
package-lock.json
*.tsbuildinfo
.DS_Store
# Build artifacts from the independent trials: their sources are kept, their
# outputs are not. Swept in once by an over-broad `git add -A` (2026-08-25).
target/
reviews/**/out/
reviews/**/__pycache__/
*.db

# Compiled trial binaries and build logs. Trial SOURCE is committed when a
# trial closes; its build output never is. Two 3.8 MB Go binaries were swept
# in by `git add -A` on 2026-08-25 and caught before the commit landed, which
# is the same mistake that put 59 MiB of Rust artifacts in this history.
reviews/**/erfval
# ...but the Go package DIRECTORY is also named erfval; re-include it, and
# the binary inside it stays excluded by the pattern above.
!reviews/**/erfval/
reviews/**/erfval-bin
reviews/**/.build-logs/
reviews/**/*.o
reviews/**/*.hi
reviews/**/*.dyn_o
reviews/**/*.dyn_hi
reviews/**/.stack-work/
reviews/**/dist-newstyle/
reviews/**/harness/*_pb2.py
reviews/**/.build/

# Held raw artifacts of third-party works (journal PDFs, HTML captures) stay
# local; the source list carries their digests. See the trial README.
reviews/2026-08-26-standards-fold-trials/bitter-lesson-corpus/corpus/raw/
reviews/2026-08-25-schema-spec-trials/essay-corpus/corpus/raw/*
!reviews/2026-08-25-schema-spec-trials/essay-corpus/corpus/raw/epistemology-for-knowledge-work-in-the-llm-era-6ed2f*
